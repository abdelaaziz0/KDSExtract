ARG SAMBA_VERSION=4.24.4
FROM debian:bookworm-slim
ARG SAMBA_VERSION
LABEL org.opencontainers.image.description="Samba AD DC ${SAMBA_VERSION} (KDSExtract lab)"
LABEL org.opencontainers.image.version="${SAMBA_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git ca-certificates \
        python3 python3-dev python3-setuptools python3-dnspython \
        libgnutls28-dev libjansson-dev libacl1-dev libattr1-dev \
        libblkid-dev libbsd-dev libcap-dev libpopt-dev libreadline-dev \
        libarchive-dev liblmdb-dev zlib1g-dev libldap2-dev libsasl2-dev \
        libgpgme-dev libgpgme11 python3-gpg libpam0g-dev libicu-dev \
        flex bison perl perl-modules libjson-perl libparse-yapp-perl \
        pkg-config tini \
        python3-markdown \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch samba-${SAMBA_VERSION} \
        https://git.samba.org/samba.git /usr/src/samba

WORKDIR /usr/src/samba

RUN ./configure --with-shared-modules='!vfs_snapper' \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig \
    && rm -rf /usr/src/samba

ENV PATH="/usr/local/samba/bin:/usr/local/samba/sbin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-cryptography python3-iso8601 python3-requests \
    && rm -rf /var/lib/apt/lists/*

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 389 636 88 464 135 139 445

HEALTHCHECK --interval=5s --timeout=3s --start-period=60s --retries=30 \
    CMD ["python3", "-c", "import socket; socket.create_connection(('127.0.0.1', 389), 3).close()"]

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
